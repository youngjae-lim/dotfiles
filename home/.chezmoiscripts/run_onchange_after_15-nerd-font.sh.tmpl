{{- if eq .chezmoi.os "linux" -}}
#!/bin/bash
# Ubuntu spares: install the Nerd Font the M2's Ghostty uses (JetBrainsMono
# NFM), so the icons in Neovim, eza, lf and the prompt show instead of boxes.
# The terminal still needs pointing at it once: Preferences → font →
# "JetBrainsMono Nerd Font Mono" (docs chapter 14). On the M2 this renders
# empty, so chezmoi skips it.
#
# run_onchange: runs again when this file changes (a new version below). A
# failed download exits non-zero, so chezmoi doesn't record it as done and
# the next apply tries again; until then `chezmoi status` shows it as R.
set -euo pipefail

version="v3.5.1" # https://github.com/ryanoasis/nerd-fonts/releases
dir="$HOME/.local/share/fonts/JetBrainsMonoNerd"
stamp="$dir/.version"

[[ -f $stamp && $(<"$stamp") == "$version" ]] && exit 0
command -v fc-cache >/dev/null || exit 0 # no fontconfig: no desktop to show fonts

tmp=$(mktemp -d)
trap 'rm -rf "$tmp"' EXIT
url="https://github.com/ryanoasis/nerd-fonts/releases/download/$version/JetBrainsMono.tar.xz"
if ! curl -fsSL "$url" -o "$tmp/font.tar.xz"; then
	echo "chezmoi: couldn't download the Nerd Font (offline?); run chezmoi apply again later" >&2
	exit 1
fi

# Only the Mono family (the "NFM" the M2 uses), not all three variants.
rm -rf "$dir"
mkdir -p "$dir"
tar -xJf "$tmp/font.tar.xz" -C "$dir" --wildcards 'JetBrainsMonoNerdFontMono-*' OFL.txt
fc-cache -f "$dir" >/dev/null
echo "$version" >"$stamp"
echo "chezmoi: installed JetBrainsMono Nerd Font Mono $version (pick it in the terminal's preferences)"
{{- end }}
