#!/bin/bash
# Claude Code PreToolUse hook: block tool calls that touch secret paths.
# Generated by chezmoi from denyPaths in home/.chezmoidata/agents.yaml.
#
# A second layer behind the permission rules. Read(~/.ssh/**) stops the Read
# tool, but not `rg token ~/.config/zsh` through an allowed Bash command; this
# hook looks at the actual paths and command text. Best effort (it can't see
# through `cd dir && cat file`), and it fails open if jq breaks, leaving the
# permission rules in place. Exit 2 blocks the call and tells Claude why.
set -uo pipefail
JQ=$(command -v jq || echo /opt/homebrew/bin/jq)

# Only paths and commands are inspected, so editing a file whose *text*
# mentions ".env" is not blocked.
targets=$("$JQ" -r '.tool_input // {} | [.file_path, .path, .notebook_path, .command]
  | map(select(type == "string")) | join("\n")') || exit 0
[[ -n $targets ]] || exit 0

# One extended regex per denyPaths glob. A name must stand on its own:
# ".env" is blocked, ".env.example" is not.
{{- $b := "(^|[^A-Za-z0-9_.-])" }}
{{- $e := "($|[^A-Za-z0-9_.-])" }}
# The globs are only labels for the message below, so ~ must stay literal.
# shellcheck disable=SC2088
globs=({{ range .agents.denyPaths }}{{ . | squote }} {{ end }})
patterns=(
{{- range .agents.denyPaths }}
{{-   $p := . | trimPrefix "**/" | trimPrefix "~/" }}
{{-   $dir := hasSuffix "/**" $p }}
{{-   $p = $p | trimSuffix "/**" | regexQuoteMeta | replace "\\*" "[^/[:space:]]*" }}
  {{ printf "%s%s%s" $b $p (ternary (printf "(/|%s)" $e) $e $dir) | squote }}
{{- end }}
)

for i in "${!patterns[@]}"; do
  if grep -Eq -- "${patterns[$i]}" <<<"$targets"; then
    echo "Blocked by the dotfiles secret guard: this touches ${globs[$i]}, which agents may not read or write. Ask the user instead." >&2
    exit 2
  fi
done
exit 0
