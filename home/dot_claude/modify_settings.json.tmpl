{{- /* Permissions come from home/.chezmoidata/agents.yaml. */ -}}
{{- $a := .agents -}}
{{- $allow := list -}}
{{- range $a.allowCommands -}}
{{-   $allow = append $allow (printf "Bash(%s:*)" .) -}}
{{-   if hasPrefix "vendor/" . }}{{ $allow = append $allow (printf "Bash(./%s:*)" .) }}{{ end -}}
{{- end -}}
{{- $ask := list -}}
{{- range $a.askCommands }}{{ $ask = append $ask (printf "Bash(%s:*)" .) }}{{ end -}}
{{- $deny := list -}}
{{- range $a.denyCommands }}{{ $deny = append $deny (printf "Bash(%s:*)" .) }}{{ end -}}
{{- range $a.denyPaths }}{{ $deny = concat $deny (list (printf "Read(%s)" .) (printf "Edit(%s)" .)) }}{{ end -}}
{{- $managed := dict
      "$schema" "https://json.schemastore.org/claude-code-settings.json"
      "permissions" (dict "defaultMode" "acceptEdits" "allow" $allow "ask" $ask "deny" $deny) -}}
{{- /* Hooks: scripts live in ~/.claude/hooks/dotfiles/. Other tools (herdr)
       add their own hooks to this file, so ours are merged in by path:
       entries pointing into hooks/dotfiles/ are replaced, the rest are kept. */ -}}
{{- $hookDir := joinPath .chezmoi.homeDir ".claude/hooks/dotfiles" -}}
{{- $hooks := dict
      "PreToolUse" (list (dict
        "matcher" "Read|Edit|MultiEdit|Write|NotebookEdit|Bash|Grep|Glob"
        "hooks" (list (dict "type" "command" "command" (joinPath $hookDir "guard-secrets.sh")))))
      "Notification" (list (dict
        "hooks" (list (dict "type" "command" "command" (joinPath $hookDir "notify.sh"))))) -}}
{{- $mergeHooks := `($extra.hooks // {}) as $mine
| ((.hooks // {})
    | map_values(map(select(any(.hooks[]?; (.command // "") | contains("/.claude/hooks/dotfiles/")) | not)))
    | with_entries(select(.value | length > 0))) as $kept
| .hooks = reduce ($mine | to_entries[]) as $e ($kept; .[$e.key] = ((.[$e.key] // []) + $e.value))
| if .hooks == {} then del(.hooks) else . end` -}}
{{- template "merge-json.sh" (dict "managed" $managed "extra" $mergeHooks "extraData" (dict "hooks" $hooks)) -}}
