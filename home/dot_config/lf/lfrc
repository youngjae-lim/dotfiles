# Like vim settings, put no in front ot the arrtibute to negate
set nodrawbox
set hidden
set icons
set ignorecase
set incsearch
set nomouse
set number
set preview
set relativenumber
set smartcase

# :  read (default)  builtin/custom command
# $  shell           shell command
# %  shell-pipe      shell command running with the ui
# !  shell-wait      shell command waiting for key press
# &  shell-async     shell command running asynchronously

# Automatically create trash folder upon the startup
${{ if [ ! -d ~/.shell/trash ]; then mkdir -p ~/.shell/trash; fi }}

# trash command to move files to trash folder
# $f = current cursor, $fs = selected files, $fx = ($fs exists) ? ($fs) : ($f)
cmd trash !{{ IFS="$(printf '\n\t')"; mv $fx ~/.shell/trash && printf ":) $fx moved to trash!\n" || printf ":( Failed to move $fx to trash\n" }}

# Remove command for bypassing trash
# rm command asks the user to confirm before removing the selected file(s)
# or the file under the cursor, and then either removes the file(s) and prints a success message,
# or prints a message if the user cancels the removal
cmd rm !{{
  printf " Remove following files?\n $fx\n"
  printf ' [y]es/[n]o: '
  read ans
  if [ "$ans" = 'y' ]; then # this is the syntax for [ ... ], use == for [[ ... ]]
    IFS="$(printf '\n\t')"; rm -rf $fx; printf "Following files have been removed!\n $fx\n";
  else
    printf ' Removal canceled \n'
  fi
}}

cmd choose_editor ${{
  printf ' Editor to open the file with: '
  read ans
  $ans "$f"
}}

# Inspiration from https://github.com/BrodieRobertson/dotfiles/blob/master/config/lf/lfrc
# mkdir function create a new directory with a name provided by the user or as an argument
cmd mkdir %{{
  if [ -z $1 ]; then
    printf ' Directory Name: '
    read ans
    mkdir $ans
  else
    mkdir $1
  fi
}}

# think about what happens if you try to open neovim in LF - yes it will break, very badly
# mkfile function create a new file with a name provided by the user or as an argument,
# and open it with the editor specified in $EDITOR
cmd mkfile ${{
  if [ -z $1 ]; then
    printf ' File Name: '
    read ans
    $EDITOR $ans
  else
    $EDITOR $1
  fi
}}

# chmod function change the permissions of the selected file(s) or the file under the cursor
# based on the mode bits provided by the user, and then refreshes the File Manager view to reflect the changes
# Mode bits example:
# 777 - rwxrwxrwx (full access)
# 755 - rwxr-xr-x (full access for owner, read and execute for others)
# 700 - rwx------ (full access for owner, nothing for others)
# 644 - rw-r--r-- (read and write for owner, read for others)
# 600 - rw------- (read and write for owner, nothing for others)
# 444 - r--r--r-- (read for all)
# 400 - r-------- (read for owner, nothing for others)
# 222 - -w--w--w- (write for all)
# 200 - -w-------- (write for owner, nothing for others)
# 111 - --x--x--x (execute for all)
# 100 - --x------- (execute for owner, nothing for others)
# 000 - ---------- (nothing for all)
cmd chmod %{{
  printf ' Mode Bits: '
  read ans

  for file in $fx; do
    chmod $ans $file
  done

  lf -remote 'send reload'
}}

# fzf_jump function allows the user to fuzzy search for a file or directory in the current directory
# and up to three levels deep, and then either select the file or change directory to the selected directory
cmd fzf_jump ${{
  res="$(find . -maxdepth 3 | fzf --reverse --header='Jump to location')"
  if [ -f "$res" ]; then
    cmd="select"
  elif [ -d "$res" ]; then
    cmd="cd"
  fi
  lf -remote "send $id $cmd \"$res\""
}}

# Archive commands
# unarchive function extracts the selected archive file
# and prints a message if the file is of an unsupported format
cmd unarchive ${{
  case "$f" in
      *.zip) unzip "$f" ;;
      *.tar.gz) tar -xzvf "$f" ;;
      *.tar.bz2) tar -xjvf "$f" ;;
      *.tar) tar -xvf "$f" ;;
      *) echo "Unsupported format" ;;
  esac
}}

cmd zip %zip -r "$f" "$f"
cmd tar %tar -cvf "$f.tar" "$f"
cmd targz %tar -czvf "$f.tar.gz" "$f"
cmd tarbz2 %tar -cjvf "$f.tar.bz2" "$f"

