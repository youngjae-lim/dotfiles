{{- /* Copilot rules come from home/.chezmoidata/agents.yaml. */ -}}
# AI agent helpers. Generated by chezmoi from agents.zsh.tmpl.

# Copilot CLI has no persistent user-level allow/deny list, so apply the shared
# policy (auto-edit + safe commands; secrets denied) on every launch.
copilot() {
  command copilot \
{{- range .agents.copilot.allowTools }}
    --allow-tool={{ . | squote }} \
{{- end }}
{{- range .agents.copilot.denyTools }}
    --deny-tool={{ . | squote }} \
{{- end }}
    "$@"
}

# `?? how do I find files over 1GB?` — quick answer, no tools.
# An alias (not a function name) so zsh doesn't glob-expand `??` or the question.
_copilot_ask() {
  [[ $# -gt 0 ]] || { echo "usage: ?? <question>"; return 1; }
  command copilot -p "Answer briefly for macOS zsh. If a shell command answers it, show the command first. Do not run anything. Question: $*" \
    --deny-tool=shell --deny-tool=write -s
}
alias '??'='noglob _copilot_ask'

# wt <branch> [claude|copilot|gemini|none] [base-ref]
# Create a git worktree for <branch> and start an agent in it.
# Inside herdr: opens a new herdr worktree workspace and starts the agent there.
# Outside herdr: creates ../<repo>--<branch> and starts the agent in this shell.
wt() {
  local branch=$1 kind=${2:-claude} base=${3:-HEAD}
  if [[ -z $branch ]]; then
    echo "usage: wt <branch> [claude|copilot|gemini|none] [base-ref]"
    return 1
  fi
  git rev-parse --show-toplevel >/dev/null 2>&1 || { echo "wt: not in a git repository"; return 1; }

  if [[ $HERDR_ENV == 1 ]]; then
    local out pane name
    out=$(herdr worktree create --cwd "$PWD" --branch "$branch" --base "$base" --label "$branch" --focus) || return
    pane=$(print -r -- "$out" | jq -r '.result.root_pane.pane_id // empty')
    [[ $kind == none || -z $pane ]] && return
    # herdr agent names: [a-z][a-z0-9_-]{0,31}
    name=${${(L)branch}//[^a-z0-9_-]/-}
    [[ $name == [a-z]* ]] || name="a-$name"
    herdr agent start "${name[1,32]}" --kind "$kind" --pane "$pane" >/dev/null
  else
    local root dir existing
    root=$(git rev-parse --show-toplevel)
    existing=$(git worktree list --porcelain | awk -v b="refs/heads/$branch" '/^worktree /{w=substr($0,10)} $0=="branch "b{print w; exit}')
    if [[ -n $existing ]]; then
      cd "$existing" || return
      [[ $kind == none ]] || $kind
      return
    fi
    dir="${root:h}/${root:t}--${branch//\//-}"
    if git show-ref --verify --quiet "refs/heads/$branch"; then
      git worktree add "$dir" "$branch" || return
    else
      git worktree add -b "$branch" "$dir" "$base" || return
    fi
    cd "$dir" || return
    [[ $kind == none ]] || $kind
  fi
}
