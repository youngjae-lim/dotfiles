# Generated by chezmoi from home/.chezmoidata/agents.yaml — edit that file instead.
# Higher priority wins: deny (300) > ask (200) > allow (100).

[[rule]]
toolName = "run_shell_command"
commandPrefix = [{{ range $i, $c := .agents.allowCommands }}{{ if $i }}, {{ end }}{{ $c | quote }}{{ end }}]
decision = "allow"
priority = 100

[[rule]]
toolName = "run_shell_command"
commandPrefix = [{{ range $i, $c := .agents.askCommands }}{{ if $i }}, {{ end }}{{ $c | quote }}{{ end }}]
decision = "ask_user"
priority = 200

{{ range .agents.denyCommands -}}
[[rule]]
toolName = "run_shell_command"
commandRegex = {{ printf "%s(\\s|\")" (regexQuoteMeta .) | quote }}
decision = "deny"
denyMessage = "Blocked by dotfiles agent policy."
priority = 300

{{ end -}}
{{- $secretPatterns := list "/\\.env\"" "/\\.env\\.local\"" "/\\.env\\.production\"" "/\\.ssh/" "/\\.config/zsh/secrets\\.zsh" "/\\.config/op/" -}}
{{ range $tool := list "read_file" "read_many_files" "write_file" "replace" -}}
{{ range $secretPatterns -}}
[[rule]]
toolName = {{ $tool | quote }}
argsPattern = {{ . | squote }}
decision = "deny"
denyMessage = "Secrets are off-limits to agents."
priority = 300

{{ end -}}
{{ end -}}
