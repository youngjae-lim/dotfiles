{{- /* VS Code (Copilot agent mode) MCP servers, from home/.chezmoidata/agents.yaml.
       "servers" is owned: add servers in agents.yaml, not in VS Code. "inputs" stays VS Code's. */ -}}
{{- $servers := dict -}}
{{- range $name, $s := .agents.mcpServers -}}
{{-   if eq $s.type "http" -}}
{{-     $_ := set $servers $name (dict "type" "http" "url" $s.url) -}}
{{-   else if eq $s.type "stdio" -}}
{{-     $_ := set $servers $name (dict "type" "stdio" "command" $s.command "args" (get $s "args" | default (list))) -}}
{{-   else -}}
{{-     fail (printf "agents.yaml: mcpServers.%s has unknown type %q" $name $s.type) -}}
{{-   end -}}
{{- end -}}
{{- template "merge-json.sh" (dict "managed" (dict "servers" $servers) "owned" (list "servers")) -}}
